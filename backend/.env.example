# Copy this file to .env and fill in what you need. Everything is optional.

# GitHub token: raises the limit from ~10 repos/hour to hundreds.
# Create at https://github.com/settings/tokens (classic, no scopes needed)
GITHUB_TOKEN=

# AI model (default: Qwen3-8B running in Ollama on this computer)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
MODEL_DISPLAY_NAME=Qwen3-8B

# Or any OpenAI-compatible server hosting an open-weight model
# (LM Studio, OpenRouter, Groq ...):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3-8b

# MongoDB Atlas connection string. Leave empty to save in backend/data/
MONGODB_URI=
MONGODB_DB=opencipher
